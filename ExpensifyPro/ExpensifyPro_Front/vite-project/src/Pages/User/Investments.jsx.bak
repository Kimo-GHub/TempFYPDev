  { label: "Total Portfolio Value", value: "$54,230", delta: "+1.2%", icon: Wallet },
  { label: "Simulated Cash", value: "$4,500", delta: "Holding 12%", icon: Coins },
  { label: "Total PnL", value: "+$2,840", delta: "+6.4%", icon: LineChart },
];

const positions = [
  { symbol: "AAPL", name: "Apple Inc.", quantity: 32, avgPrice: 165.2, currentPrice: 178.5, pnl: 429.6 },
  { symbol: "TSLA", name: "Tesla", quantity: 15, avgPrice: 234.4, currentPrice: 242.1, pnl: 115.5 },
  { symbol: "VOO", name: "Vanguard S&P 500", quantity: 18, avgPrice: 385.0, currentPrice: 400.2, pnl: 273.6 },
