  {
    title: "Rebalance monthly",
    description: "Keep equities at 80% and cash at 20%; rebalance monthly.",
    status: "Active",
    lastRun: "3d ago",
  },
  {
    title: "Volatility guard",
    description: "Pause new buys if any holding drops more than 7% in a day.",
    status: "Paused",
    lastRun: "1w ago",
  },
];

const currency = (value) =>
  `$${value.toLocaleString("en-US", {
    minimumFractionDigits: 2,
    maximumFractionDigits: 2,
  })}`;

export default function Investments() {
